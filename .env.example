
CONSUMER_GROUP=
CONSUMER_USERNAME=
CONSUMER_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_CONFIG=
KAFKA_SECURITY_PROTOCOL=

JSON_TOPIC=

USER_SETTINGS_PATH=
TIMETABLE_PATH=

# Used by docker-compose.yml to create the Postgres container + its default
# database. Keep these in sync with DB_PATH below.
POSTGRES_USER=trainstatus
POSTGRES_PASSWORD=trainstatus
POSTGRES_DB=trainstatus

# Postgres DSN, e.g. postgresql://user:password@host:5432/dbname
# With `docker compose up`, Postgres is reachable at localhost:5432 from the
# host, so: postgresql://trainstatus:trainstatus@localhost:5432/trainstatus
DB_PATH=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Prefix within the bucket where CIF schedule files land (adjust to your setup)
S3_SCHEDULE_PREFIX=/

# Local paths
DOWNLOAD_DIR=
EXTRACT_DIR=

# How many local extracted files to keep before deleting old ones
RETAIN_VERSIONS=2
