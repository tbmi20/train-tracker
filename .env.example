
CONSUMER_GROUP=
CONSUMER_USERNAME=
CONSUMER_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_CONFIG=
KAFKA_SECURITY_PROTOCOL=

JSON_TOPIC=

# Only used by the (optional) one-time seed import - main.py's live watchlist
# now comes from Postgres (watchlist_stations/watchlist_trains), managed via
# services/api.py.
USER_SETTINGS_PATH=

# Used by docker-compose.yml to create the Postgres container + its default
# database. Keep these in sync with DB_PATH below.
POSTGRES_USER=trainstatus
POSTGRES_PASSWORD=trainstatus
POSTGRES_DB=trainstatus

# Postgres DSN, e.g. postgresql://user:password@host:5432/dbname
# With `docker compose up`, Postgres is reachable at localhost:5433 from the
# host (5433, not 5432 - see docker-compose.yml's comment on the postgres
# service's port mapping): postgresql://trainstatus:trainstatus@127.0.0.1:5433/trainstatus
DB_PATH=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Prefix within the bucket where CIF schedule files land (adjust to your setup)
S3_SCHEDULE_PREFIX=/

# Specific object keys under the bucket/prefix above, used by
# dags/nightly_schedule_download.py
S3_WEEKLY_SCHEDULE=timetable_full.zip
S3_DAILY_UPDATE=timetable_update.zip

# Local paths (inside the Airflow container - see docker-compose.yml)
DOWNLOAD_DIR=
EXTRACT_DIR=

# How many local extracted files to keep before deleting old ones
RETAIN_VERSIONS=2
